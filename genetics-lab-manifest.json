  "changelog": [
    {
      "version": "1.11.0",
      "date": "2026-10-13",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Show the guided breeding step in a 3D planter; fix black plant leaves"
          ]
        }
      ]
    },
    {
      "version": "1.10.0",
      "date": "2026-10-13",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Interactive 3D planter guide with Rust's own planter and plant models"
          ]
        }
      ]
    },
    {
      "version": "1.9.0",
      "date": "2026-10-13",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Open patch notes at any time"
          ]
        }
      ]
    },
    {
      "version": "1.8.0",
      "date": "2026-10-13",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Ship update manifests and show updates inside Genetics Lab"
          ]
        }
      ]
    },
    {
      "version": "1.7.0",
      "date": "2026-10-12",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Correct every recipe and add the livestock-update pies and breads"
          ]
        }
      ]
    },
    {
      "version": "1.6.0",
      "date": "2026-10-02",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Update genetics rules and add a Rules tab"
          ]
        }
      ]
    },
    {
      "version": "1.5.0",
      "date": "2026-10-02",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Show each pair's expected newborn gene by gene"
          ]
        }
      ]
    },
    {
      "version": "1.4.0",
      "date": "2026-10-02",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Show sex with icons and set it in one click",
            "Mark livestock genetics as beta",
            "Read animal names and never add one animal twice",
            "Add the Milky and Creamy teas from the livestock update",
            "Detect the animal's kind from the panel portrait",
            "Model hidden gene copies and real inheritance",
            "Scan livestock genes and suggest breeding pairs"
          ]
        },
        {
          "title": "Bug Fixes",
          "items": [
            "Tell lamb from sheep and stay unsure between cow and calf",
            "Read marker numbers, age and condition from the live panel"
          ]
        }
      ]
    },
    {
      "version": "1.3.1",
      "date": "2026-09-11",
      "sections": [
        {
          "title": "Bug Fixes",
          "items": [
            "Take capture frames off the track, not the video element",
            "Read gene rows from the badges instead of saved coordinates"
          ]
        }
      ]
    },
    {
      "version": "1.3.0",
      "date": "2026-09-07",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Improve route grouping, default presets, and clone readiness feedback"
          ]
        }
      ]
    },
    {
      "version": "1.2.1",
      "date": "2026-09-04",
      "sections": [
        {
          "title": "Bug Fixes",
          "items": [
            "Replace awk in release notes extraction with node script"
          ]
        }
      ]
    },
    {
      "version": "1.2.0",
      "date": "2026-09-04",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Display version in About modal title and under gene input"
          ]
        },
        {
          "title": "Performance Improvements",
          "items": [
            "Accelerate GitHub Actions with multi-layer caching and single-pass build"
          ]
        },
        {
          "title": "Code Refactoring",
          "items": [
            "Decouple version bumping and release publishing into standalone workflows"
          ]
        }
      ]
    },
    {
      "version": "1.1.0",
      "date": "2026-09-04",
      "sections": [
        {
          "title": "Features",
          "items": [
            "Add automated version bumping, releases, and dist asset packaging",
            "Desktop capture path with slot extraction and auto-calibration",
            "Add NVIDIA Reflex ON + BOOST notice, graphics.reflexmode 2 command, and scanner optimizations",
            "Read genes with two recognisers and report why a slot fails",
            "Add manual capture with confirmation, fix detection flicker",
            "Classify gene glyphs by template instead of running OCR",
            "Add phone camera scanner (beta)",
            "Redesign route inspector workflow",
            "Rebuild farm operations planner",
            "Refine genetics workspace and solver",
            "Default anonymous stats on",
            "Complete responsive accessibility remediation",
            "Implement 2-level breeding routes sorting and OCR warmup improvements",
            "Auto-advance to next line after 6 genes, wrap overflow",
            "Match-mode filtering, responsive layout, perf & UX fixes",
            "Rework scan/typing sounds",
            "V1.0.0 — route grouping, alt-plan selection, generation markers, promo slot",
            "Editable target input, smarter presets, tooltips, hover-scroll tabs, light-mode fixes",
            "Configure Coolify Docker deployment and Nginx SPA hosting",
            "Add real-time starvation detection and in-game <= 50 FPS cap warning",
            "Add GitHub repository and contribute links to header and about modal",
            "Initialize standalone Rust Genetics Lab web application repository"
          ]
        },
        {
          "title": "Bug Fixes",
          "items": [
            "Ignore ink detached from the glyph, and let OCR abstain",
            "Match glyph shape instead of glyph ink",
            "Let the recogniser judge legibility, and give capture a target",
            "Threshold glyphs with Otsu and show the real OCR input",
            "Apply the raised distance limit and hold the accepted state",
            "Read genes per slot and stop discarding good samples",
            "Unblock camera OCR and tolerate handheld shake",
            "De-duplicate scanned clones and fix scan sound effects",
            "Improve light mode color contrast and UI tokens across all components"
          ]
        },
        {
          "title": "Performance Improvements",
          "items": [
            "Rewrite crossbreeding core around pre-allocation admission test",
            "Prune unreliable plans and prioritize 100%/low-gen routes"
          ]
        }
      ]
    }
  ],
